generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  DOMAIN
  IP
}

enum AssetStatus {
  PENDING
  VERIFIED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScanRunStatus {
  RUNNING
  DONE
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  assets                   Asset[]
  passiveLookupRuns        PassiveLookupRun[]
  publicVisualAnalysisRuns PublicVisualAnalysisRun[]
}

model PassiveLookupRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  target     String
  targetType String   // "DOMAIN" | "IP"
  source     String   @default("OTX")
  status     String   @default("DONE") // "DONE" | "ERROR" | "SKIPPED"

  otxJson            Json?
  aiSummary          String?
  aiRecommendations  Json?  // String[]

  error      String?

  checkedAt  DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, checkedAt])
  @@index([target])
}

model Asset {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  type         AssetType
  value        String
  status       AssetStatus @default(PENDING)
  critical     Boolean     @default(false)
  scanInterval String      @default("24h") // 1h | 6h | 24h | 7d
  createdAt    DateTime    @default(now())

  verifications      AssetVerification[]
  scanRuns           ScanRun[]
  findings           Finding[]
  sqliTargets        SqliTarget[]
  visualAnalysisRuns VisualAnalysisRun[]

  @@index([userId])
  @@index([status])
  @@unique([type, value, userId])
}

model AssetVerification {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  method     String   // DNS_TXT | HTTP_FILE (MVP)
  token      String
  createdAt  DateTime @default(now())
  verifiedAt DateTime?

  @@index([assetId])
}

model ScanRun {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id])

  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  status     ScanRunStatus @default(RUNNING)

  // Tarama bitişinde dondurulan aktif bulgu sayısı. Finding.scanRunId bir
  // sonraki taramada en güncel run'a taşındığı için _count.findings tarihsel
  // olarak güvenilir değildir; bu skalar, o taramanın o anki sonucunu kalıcı tutar.
  findingsCount Int @default(0)

  checkResults ScanCheckResult[]
  findings     Finding[]

  @@index([assetId])
  @@index([assetId, startedAt])
}

model ScanCheckResult {
  id        String   @id @default(cuid())

  scanRunId String
  scanRun   ScanRun  @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  type      String   // HTTP_HEALTH / TLS_INFO / PORTS
  dataJson  Json

  createdAt DateTime @default(now())

  @@index([scanRunId])
  @@index([type])
}

model Finding {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])

  scanRunId String
  scanRun   ScanRun  @relation(fields: [scanRunId], references: [id])

  type       String
  key        String
  severity   FindingSeverity @default(LOW)

  dataJson   Json
  aiScore    Int
  aiWhyJson  Json

  isNew      Boolean  @default(true)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([assetId])
  @@index([scanRunId])
  @@index([aiScore])
  @@index([type])
  @@unique([assetId, key])
}

model SqliTarget {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  method      String   // MVP: sadece "GET"
  path        String   // örn: "/product" veya "/search"
  paramsJson  Json     // örn: { "id": "1" } veya { "q": "test" }
  injectParam String   // paramsJson içindeki bir key — örn: "id" veya "q"
  enabled     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([assetId, enabled])
}

model VisualAnalysisRun {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  url        String
  finalUrl   String?
  statusCode Int?

  screenshotPath   String?
  screenshotHash   String?
  screenshotWidth  Int?
  screenshotHeight Int?

  title           String?
  metaDescription String?
  h1TextsJson     Json?
  visibleText     String?  @db.Text
  visibleTextHash String?

  siteCategory   String?
  purposeSummary String?  @db.Text
  language       String?

  signalsJson  Json?
  analysisJson Json?
  riskLevel    String?

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, createdAt])
  @@index([url])
}

// Public Web Intelligence — verified asset gerektirmeyen, kullanıcının girdiği
// public URL üzerinde tek seferlik screenshot + AI görsel analiz. Tarama veya
// finding üretmez; sadece görsel açıklama.
model PublicVisualAnalysisRun {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Kullanıcının girdiği URL — normalize edilmiş (http/https zorunlu).
  url        String
  finalUrl   String?
  statusCode Int?

  // Hayat döngüsü: RUNNING → DONE (veya FAILED).
  // Frontend polling bu alana göre döngüsünü bitirir.
  status String @default("RUNNING") // RUNNING | DONE | FAILED

  // Screenshot diske yazılır; path Worker tarafından doldurulur. Bu alan
  // dolduğunda frontend "AI henüz hazırlanıyor ama screenshot var" durumunu
  // göstererek staged UX'i mümkün kılar.
  screenshotPath   String?
  screenshotHash   String?
  screenshotWidth  Int?
  screenshotHeight Int?

  // DOM özet alanları (rule-based analiz için kullanılır)
  title           String?
  metaDescription String?
  h1TextsJson     Json?
  visibleText     String?  @db.Text
  visibleTextHash String?

  // Rule-based çıktı (worker tarafından doldurulur)
  ruleSiteCategory   String?
  rulePurposeSummary String?  @db.Text
  ruleLanguage       String?
  ruleSignalsJson    Json?
  ruleRiskLevel      String?

  // AI vision çıktısı — tam AiVisualAnalysisResult JSON'u.
  // sitePurpose/siteCategory/visualSummary/userFacingDescription/pageTone/
  // targetAudience/confidence/visibleElements/securitySignals/recommendations
  // burada saklanır. Boş gelirse status'tan ayırt edilir.
  aiVisualAnalysisJson Json?

  // Hata: backend tarafında uçtan uca yumuşak başarısızlık. Job processor
  // throw etmek yerine bu alanı doldurur ve status='FAILED' yapar.
  error String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  finishedAt  DateTime?

  @@index([userId, createdAt])
  @@index([status])
}