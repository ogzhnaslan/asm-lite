{
    "name": "worker",
    "private": true,
    "version": "0.0.1",
    "type": "commonjs",
    "scripts": {
        "start": "tsx src/worker.ts",
        "dev": "tsx watch src/worker.ts",
        "build": "tsc",
        "start:prod": "node dist/worker.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "lab:200": "node lab/lab-200.js",
        "lab:500": "node lab/lab-500.js"
    },
    "dependencies": {
        "@asm/shared": "workspace:*",
        "@anthropic-ai/sdk": "^0.91.1",
        "@prisma/adapter-pg": "^7.4.1",
        "@prisma/client": "^7.4.1",
        "bullmq": "^5.70.1",
        "dotenv": "^17.3.1",
        "pg": "^8.18.0",
        "playwright": "^1.49.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "jest": "^29.7.0",
        "prisma": "^7.4.1",
        "ts-jest": "^29.2.5",
        "tsx": "^4.19.0",
        "typescript": "^5.7.3"
    },
    "jest": {
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": ["ts-jest", {
                "tsconfig": {
                    "module": "commonjs",
                    "moduleResolution": "node"
                }
            }]
        },
        "testEnvironment": "node",
        "setupFiles": ["<rootDir>/../jest.setup.ts"]
    }
}
